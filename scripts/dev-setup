# ========== 全局配置 ==========

# 颜色定义
class Colors:
    RESET = '\033[0m'
    RED = '\033[91m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    BLUE = '\033[94m'
    MAGENTA = '\033[95m'
    CYAN = '\033[96m'
    WHITE = '\033[97m'
    BOLD = '\033[1m'
    DIM = '\033[2m'


# 任务状态符号
class TaskSymbols:
    PENDING = f"{Colors.BLUE}⏺{Colors.RESET}"
    RUNNING = f"{Colors.YELLOW}⏺{Colors.RESET}"
    SUCCESS = f"{Colors.GREEN}✓{Colors.RESET}"
    FAILED = f"{Colors.RED}✗{Colors.RESET}"
    WARNING = f"{Colors.YELLOW}⚠{Colors.RESET}"


# 全局变量
SKIP_CONFIRMATIONS = False
USER_CANCELLED = False
SAFE_MODE = os.environ.get('CI') == 'true' or not sys.stdin.isatty()
NO_MENU = SAFE_MODE
SIMPLE_MODE = False  # 简单输出模式
CURRENT_MODE = None  # 当前选择的模式
LAST_EXECUTOR = None  # 最后执行的TaskExecutor实例


# ========== 任务定义（数据驱动） ==========

def get_commands_mapping():
    """获取命令映射表"""
    return {
        # 检查命令
        "check:docker": lambda: "docker version",
        "check:envpatch": lambda: "command -v env-patch",

        # 配置生成
        "config:backend": lambda envpatch=None: (
            f"cd backend && ../env-patch -p {envpatch} -o .env" if envpatch
            else "cd backend && test -f .env.dev.envpatch && ../env-patch || echo '跳过 Backend 配置生成（未找到 envpatch 文件）'"
        ),
        "config:docker": lambda envpatch=None: (
            f"cd docker && ../env-patch -p {envpatch} -o .env" if envpatch
            else "cd docker && test -f .env.dev.envpatch && ../env-patch  || echo '跳过 Docker 配置生成（未找到 envpatch 文件）'"
        ),
        "config:web": lambda: "cd web && test -f .env.dev.envpatch && ../env-patch || true",

        # Docker 操作
        "docker:down": lambda path="docker", services=None: (
            f"cd {path} && docker compose down" if not services
            else f"cd {path} && docker compose down {' '.join(services)}"
        ),
        "docker:down-all": lambda: "cd docker && docker compose down -v --remove-orphans",
        "docker:down-db-redis": lambda: "cd docker && docker compose rm -s -f -v postgres redis",
        "docker:up-all": lambda path="docker", services=None, force_recreate=True: (
            f"cd {path} && docker compose up -d --wait{' --force-recreate' if force_recreate else ''}" if not services
            else f"cd {path} && docker compose up -d --wait{' --force-recreate' if force_recreate else ''} {' '.join(services)}"
        ),
        "docker:up-db-redis": lambda: "cd docker && docker compose up -d --wait --force-recreate postgres redis",

        # 构建命令
        "build:backend": lambda platform=None: f"./build-image backend{f' --platform {platform}' if platform else ''}",
        "build:web": lambda platform=None: f"./build-image web{f' --platform {platform}' if platform else ''}",

        # 依赖安装
        "deps:uv": lambda: "command -v uv || pip install uv -i https://mirrors.aliyun.com/pypi/simple",
        "deps:backend": lambda: "cd backend && ([ -d .venv ] || uv venv) && uv sync --dev",
        "deps:web": lambda: "cd web && pnpm install",

    }


